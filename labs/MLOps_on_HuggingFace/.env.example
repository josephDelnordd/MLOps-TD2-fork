# ==========================================================================
# .env.example — copy this file to `.env` and fill in your own values.
#
#   cp .env.example .env
#
# `.env` is already excluded by the repo's top-level .gitignore, so it will
# never be committed. NEVER put your real token directly in code, in a
# Makefile, or in a notebook cell that you might push to GitHub or the Hub.
# ==========================================================================

# Your Hugging Face access token.
# Create one at: https://huggingface.co/settings/tokens
# Needs at least "Write" scope to push models/datasets/Spaces from the labs.
HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Your Hugging Face username (used to build repo ids like <HF_USERNAME>/vit-beans-demo)
HF_USERNAME=your-hf-username
